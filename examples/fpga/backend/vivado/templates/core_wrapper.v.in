// carolyne_core_wrapper — the emitted machine behind a BRAM_PORTA interface.
// Generated by examples/fpga/backend/vivado from core_wrapper.v.in; the block
// design connects the AXI BRAM controller to it with one interface net, and
// the emitted top's generated name never appears in the design.
//
// bram_clk and bram_rst are the controller's, left unused: the machine runs
// on the same pl_clk0 and takes its reset from the AXI GPIO on `mrst`.

`timescale 1ns / 1ps

module {WRAPPER_MODULE} (
    (* X_INTERFACE_INFO = "xilinx.com:signal:clock:1.0 clk CLK" *)
    input  wire                   clk,
    input  wire                   mrst,

    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA CLK" *)
    (* X_INTERFACE_PARAMETER = "MASTER_TYPE BRAM_CTRL, MEM_SIZE {WINDOW_BYTES}, MEM_WIDTH 32, MEM_ECC NONE, READ_WRITE_MODE READ_WRITE, READ_LATENCY 1" *)
    input  wire                   bram_clk,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA RST" *)
    input  wire                   bram_rst,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA EN" *)
    input  wire                   bram_en,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA WE" *)
    input  wire [3:0]             bram_we,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA ADDR" *)
    input  wire [{ADDR_BITS}-1:0] bram_addr,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA DIN" *)
    input  wire [31:0]            bram_din,
    (* X_INTERFACE_INFO = "xilinx.com:interface:bram_rtl:1.0 BRAM_PORTA DOUT" *)
    output wire [31:0]            bram_dout
);

    {TOP_MODULE} machine (
        .clk        (clk),
        .mrst       (mrst),
        .host_en    (bram_en),
        .host_we    (bram_we),
        .host_addr  (bram_addr),
        .host_wdata (bram_din),
        .host_rdata (bram_dout)
    );

endmodule
